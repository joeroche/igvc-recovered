<launch>
  <!-- keyboard already has its own built in velocity smoother -->
  <node pkg="teleop" type="keyboard" name="pathfinder_teleop_keyboard"  output="screen">
    <param name="scale_linear" value="0.5" type="double"/>
    <param name="scale_angular" value="1.5" type="double"/>
  </node>

	  <node pkg="setup" type="led_control" name="led_control"/>

  <include file="$(find odrive_ros)/launch/odrive.launch"/> 
</launch>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Depth camera's urdf -->
    <joint name="depth_camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="depth_camera_link"/>
        <origin xyz="0.175 0 0.08" rpy="0 0 0"/>
    </joint>
    <link name="depth_camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            
        </visual>
    </link>
    <!-- Depth camera Optical link -->
    <joint name="depth_camera_optical_joint" type="fixed">
        <parent link="depth_camera_link"/>
        <child link="depth_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="depth_camera_link_optical"></link>

    <!-- Depth camera Gazebo Sensor Plugin -->
    <gazebo reference="depth_camera_link">
        

        <sensor name="depth" type="rgbd">
            <pose> 0 0 0 0 0 0 </pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>depth_camera/image</topic>
            <gz_frame_id>depth_camera_link</gz_frame_id>
            <camera>
                <optical_frame_id>depth_camera_link_optical</optical_frame_id>
                <camera_info_topic>camera/depth_camera_info</camera_info_topic>
                <horizontal_fov>2.5</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>16.0</far>
                </clip>
            </camera>
        </sensor>

    </gazebo>

</robot>
